# Trading Agent — Environment Variables
# Copy this to .env and fill in your real keys
# NEVER commit .env to git, and never put real keys into this file

# Alpaca paper trading — keys from https://app.alpaca.markets → API Keys
APCA_API_KEY_ID=your_paper_api_key_here
APCA_API_SECRET_KEY=your_paper_api_secret_here
APCA_BASE_URL=https://paper-api.alpaca.markets
