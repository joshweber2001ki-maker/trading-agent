# Trading-Bot — Umgebungsvariablen (nur für lokale Tests).
# Auf dem Server liegen die Werte in /etc/trading-bot/ (siehe deploy/set-keys.sh).
# Echte Schlüssel NIE in diese Datei oder ins Repo schreiben.

APCA_API_KEY_ID=your_paper_api_key_here
APCA_API_SECRET_KEY=your_paper_api_secret_here
APCA_BASE_URL=https://paper-api.alpaca.markets

# Für die Bewertung der Nachrichten (ohne diesen Schlüssel läuft nur die Ausbruchs-Strategie)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
