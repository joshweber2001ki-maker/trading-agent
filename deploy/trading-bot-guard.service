[Unit]
Description=Trading bot guard: nothing stays open over the close, and nothing unwatched before the open or after the close
ConditionPathExists=/etc/trading-bot/alpaca.env

[Service]
Type=oneshot
User=trader
WorkingDirectory=/opt/trading-agent
EnvironmentFile=/etc/trading-bot/alpaca.env
Environment=BOT_DATA_DIR=/var/lib/trading-bot
ExecStart=/opt/trading-agent/.venv/bin/python tools/guard.py
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/trading-bot
ProtectHome=true
PrivateTmp=true
